import matplotlib.pyplot as plt
from matplotlib.patches import Circle, PathPatch
from matplotlib.path import Path

plt.rcParams["font.sans-serif"] = [
    "Microsoft YaHei", "SimHei", "Arial Unicode MS", "DejaVu Sans"
]
plt.rcParams["axes.unicode_minus"] = False

fig, ax = plt.subplots(figsize=(8.7, 6.2), dpi=100)
fig.patch.set_facecolor("#1b2048")
ax.set_facecolor("#1b2048")
ax.set_xlim(0, 8.7)
ax.set_ylim(0, 6.2)
ax.axis("off")

ax.text(
    0.55, 5.84, "本科及以上学历员占比",
    color="white", fontsize=27, fontweight="bold", va="top"
)
ax.text(
    0.55, 5.36, "6月30日最新统计数据本科及以上员工占比65%",
    color="white", fontsize=20, va="top"
)

cx, cy = 4.48, 2.72
outer_radius = 1.90
inner_radius = 1.72
level = 3.10
verts = [
    (cx - inner_radius - 0.04, level + 0.10),
    (cx - 1.48, level + 0.42),
    (cx - 0.90, level - 0.38),
    (cx - 0.30, level + 0.12),
    (cx + 0.28, level + 0.43),
    (cx + 0.85, level - 0.40),
    (cx + 1.45, level + 0.15),
    (cx + inner_radius + 0.04, level + 0.10),
    (cx + inner_radius + 0.04, cy - inner_radius - 0.04),
    (cx - inner_radius - 0.04, cy - inner_radius - 0.04),
    (cx - inner_radius - 0.04, level + 0.10),
]

codes = [
    Path.MOVETO,
    Path.CURVE4, Path.CURVE4, Path.CURVE4,
    Path.CURVE4, Path.CURVE4, Path.CURVE4,
    Path.LINETO, Path.LINETO, Path.LINETO,
    Path.CLOSEPOLY
]

liquid = PathPatch(
    Path(verts, codes),
    facecolor="#087cc5",
    edgecolor="none",
    zorder=2
)
inner_circle = Circle((cx, cy), inner_radius, transform=ax.transData)
liquid.set_clip_path(inner_circle)
ax.add_patch(liquid)

ax.add_patch(
    Circle(
        (cx, cy),
        outer_radius,
        facecolor="none",
        edgecolor="#0084d8",
        linewidth=2.2,
        zorder=4
    )
)

ax.text(
    cx, cy + 0.28, "65%",
    color="white",
    fontsize=49,
    ha="center",
    va="center",
    zorder=5
)

ax.text(
    0.55, 0.29,
    "*注：数据来源于公司人力资源系统",
    color="#d8d8e4",
    fontsize=12,
    va="bottom"
)

plt.tight_layout(pad=0)
plt.show()