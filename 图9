import numpy as np
import matplotlib.pyplot as plt
from matplotlib import font_manager

available = {font.name for font in font_manager.fontManager.ttflist}
for name in ("Microsoft YaHei", "SimHei", "Noto Sans CJK SC"):
    if name in available:
        plt.rcParams["font.sans-serif"] = [name]
        break
plt.rcParams["axes.unicode_minus"] = False

labels = ["口红", "面膜", "隔离", "防晒", "精华"]
old = np.array([3568, 4135, 4436, 4106, 4936])
new = np.array([2569, 3241, 2965, 3209, 3541])
diff = old - new
x = np.arange(len(labels))
width = 0.23

fig, ax = plt.subplots(figsize=(12, 8.9), dpi=100)
fig.patch.set_facecolor("#191e49")
ax.set_facecolor("#191e49")
ax.set_xlim(-0.7, 4.7)
ax.set_ylim(-1830, 9250)
ax.axis("off")

ax.text(-0.52, 8480, "2022年商品对比去年销售情况", color="white",
	fontsize=29, fontweight="bold", va="top")
ax.text(-0.52, 7600, "商品整体比去年销量有所下降，其中隔离下降最多，下降33%",
	color="white", fontsize=16, va="top")

ax.scatter([-0.44, 0.29], [6003, 6003], s=70, marker="s",
	   color=["#087ac5", "#83acd4"])
ax.text(-0.36, 6000, "2021销量", color="white", fontsize=12, va="center")
ax.text(0.37, 6000, "2022销量", color="white", fontsize=12, va="center")

b1 = ax.bar(x - width / 2, old, width, color="#087ac5")
b2 = ax.bar(x + width / 2, new, width, color="#83acd4")

for bar, value in zip(b1, old):
    ax.text(bar.get_x() + bar.get_width() / 2, value + 120, str(value),
	    ha="center", va="bottom", color="white", fontsize=11)
for bar, value in zip(b2, new):
    ax.text(bar.get_x() + bar.get_width() / 2, value - 110, str(value),
	    ha="center", va="top", color="white", fontsize=11)

ax.plot([-0.68, 4.68], [0, 0], color="#9296ae", lw=1.4)
for i, label in enumerate(labels):
    ax.text(i, -300, label, ha="center", va="top", color="white", fontsize=13)

for i, value in enumerate(diff):
    arrow_x = i + width / 2
    ax.plot([i - width / 2, arrow_x], [old[i], old[i]],color="#087ac5", lw=1.2)
    ax.annotate("", xy=(arrow_x, old[i]), xytext=(arrow_x, new[i]),
		arrowprops={"arrowstyle": "-|>", "color": "white", "lw": 1.5})
    ax.text(arrow_x + 0.07, (old[i] + new[i]) / 2, str(value),
	    color="white", fontsize=11, va="center")

ax.text(-0.82, -1550, "注：数据来源于公司销售系统，统计日期截至2022.01.01",
	color="white", fontsize=12, va="bottom")
plt.tight_layout(pad=0)
plt.show()
