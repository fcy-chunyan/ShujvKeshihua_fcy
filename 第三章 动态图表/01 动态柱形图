"""
第3章 动态图表 —— 表1：动态柱形图（深色样式 + 单元格式下拉控件）
"""
import json
from pathlib import Path
from pyecharts.charts import Bar
from pyecharts import options as opts
HERE = Path(__file__).resolve().parent
JS = HERE / "echarts.min.js"

#  源数据（原表 B3:H9）
months = ["1月", "2月", "3月", "4月", "5月", "6月"]
regions = ["华北", "华南", "东北", "西北", "西南", "华东"]
data = {
    "1月": [259, 247, 705, 513, 463, 384],
    "2月": [235, 266, 529, 324, 579, 282],
    "3月": [330, 342, 705, 540, 492, 308],
    "4月": [282, 342, 599, 270, 492, 384],
    "5月": [282, 323, 705, 486, 405, 308],
    "6月": [965, 380, 282, 567, 463, 897],
}

BG = "#1b1f3b"             
BAR = "#1990ef"             
AXIS_TEXT = "#c9d2f5"       
GRID_LINE = "rgba(255,255,255,0.22)"  

# 用 pyecharts 生成基础 option（初始为 5 月）
bar = (
    Bar(init_opts=opts.InitOpts(width="1000px", height="580px", bg_color=BG))
    .add_xaxis(regions)
    .add_yaxis("人数", data["5月"], bar_width="48%",
               itemstyle_opts=opts.ItemStyleOpts(color=BAR),
               label_opts=opts.LabelOpts(is_show=False))
    .set_global_opts(
        title_opts=opts.TitleOpts(
            title="2022年上半年各区域销售情况",
            pos_left="5%", pos_top="6%",
            title_textstyle_opts=opts.TextStyleOpts(color="#ffffff", font_size=30, font_weight="bold")),
        tooltip_opts=opts.TooltipOpts(trigger="axis", axis_pointer_type="shadow",
                                      background_color="rgba(20,25,55,0.9)",
                                      textstyle_opts=opts.TextStyleOpts(color="#fff")),
        legend_opts=opts.LegendOpts(is_show=False),
        xaxis_opts=opts.AxisOpts(
            axislabel_opts=opts.LabelOpts(color=AXIS_TEXT, font_size=14),
            axisline_opts=opts.AxisLineOpts(linestyle_opts=opts.LineStyleOpts(color="rgba(255,255,255,0.35)")),
            axistick_opts=opts.AxisTickOpts(is_show=False),
            splitline_opts=opts.SplitLineOpts(is_show=False)),
        yaxis_opts=opts.AxisOpts(
            type_="value", min_=0, max_=800, interval=200,
            axislabel_opts=opts.LabelOpts(color=AXIS_TEXT, font_size=13),
            splitline_opts=opts.SplitLineOpts(
                is_show=True, linestyle_opts=opts.LineStyleOpts(type_="dashed", color=GRID_LINE, width=1.5)),
            axisline_opts=opts.AxisLineOpts(is_show=False),
            axistick_opts=opts.AxisTickOpts(is_show=False)),
    )
)
bar.options["grid"] = opts.GridOpts(pos_left="9%", pos_right="6%", pos_top="30%", pos_bottom="13%").opts
option_json = bar.dump_options_with_quotes()   # JSON 对象字面量，可直接嵌入 JS

# 下拉框选项（默认选中 5 月）
select_html = "".join(
    '<option value="%s"%s>%s</option>' % (m, " selected" if m == "5月" else "", m)
    for m in months
)
month_data_json = json.dumps(data, ensure_ascii=False)

# 拼装独立 HTML：下拉框(控件单元格) 驱动图表 
echarts_js = JS.read_text(encoding="utf-8") if JS.exists() else ""
html = """<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>动态柱形图 · 下拉控件</title>
<style>
  html,body{margin:0;padding:0;background:%(bg)s;}
  #wrap{position:relative;width:1000px;height:580px;margin:0 auto;background:%(bg)s;}
  #sel{position:absolute;top:50px;right:45px;z-index:10;
       font-size:15px;padding:6px 26px 6px 12px;color:#222;
       background:#eef1f6;border:1px solid #cfd6e6;border-radius:2px;cursor:pointer;}
  #note{position:absolute;left:5%%;bottom:16px;color:#8b93b8;font-size:13px;}
</style>
<script>%(echarts)s</script>
</head>
<body>
<div id="wrap">
  <select id="sel">%(select)s</select>
  <div id="chart" style="width:1000px;height:580px;"></div>
  <div id="note">*注：数据来源公司销售系统</div>
</div>
<script>
var chart = echarts.init(document.getElementById('chart'));
var option = %(option)s;
chart.setOption(option);
var monthData = %(monthdata)s;
// 下拉框（对应 Excel 控件单元格 J3）：选中月份 → 更新柱子数据，并让 Y 轴自适应
document.getElementById('sel').onchange = function () {
  var d = monthData[this.value];
  var ymax = Math.ceil(Math.max.apply(null, d) / 200) * 200;
  chart.setOption({
    yAxis: [{ max: ymax }],
    series: [{ data: d }]
  });
};
</script>
</body>
</html>
""" % {
    "bg": BG,
    "echarts": echarts_js,
    "select": select_html,
    "option": option_json,
    "monthdata": month_data_json,
}

out = HERE / "01_动态柱形图.html"
out.write_text(html, encoding="utf-8")
print("OK ->", out)