import plotly.express as px
import pandas as pd
import os

data = {
    "经济学院": ["经济学", "金融学", "国际经济与贸易", "跨境电子商务", "数字经济"],
    "商学院": ["财务管理", "工商管理", "会计学", "人力资源管理", "物流管理",
             "信息管理与信息系统", "市场营销"],
    "马克思主义学院（中共党史党建学院）": ["中国共产党历史"],
    "机械工程学院（机器人工程学院）": ["智能制造与工程", "车辆工程", "电气工程及其自动化",
                                "机器人工程", "机械设计制造及其自动化"],
    "信息科学与工程学院": ["电子信息工程", "通信工程"],
    "人工智能学院": ["网络工程", "软件工程", "计算机科学与技术", "人工智能"],
    "数据科学学院": ["应用统计学", "数学与应用数学", "金融数学", "数据科学与大数据技术"],
    "医学院": ["临床医学", "护理学", "药学", "麻醉学"],
    "设计学院": ["视觉传达设计", "服装设计与工程", "工业设计", "数字媒体艺术"],
    "生物与化学工程学院": ["应用化学", "化学工程与工艺专业", "环境工程", "生物工程", "制药工程"],
    "材料与纺织工程学院": ["纺织工程", "高分子材料与工程", "轻化工程",
                   "新能源材料与器件", "非织造材料与工程"],
    "建筑工程学院": ["土木工程", "工程管理", "建筑环境与能源应用工程", "建筑学"],
    "文法学院": ["汉语言文学", "汉语国际教育", "法学", "知识产权"],
    "外国语学院": ["英语", "日语"],
    "平湖师范学院（教育学院）": ["学前教育", "小学教育", "体育教育"],
}

print("嘉兴大学15个学院本科专业分布：")
for college, majors in data.items():
    print(f"\n {college}（{len(majors)}个专业）")
    for i, major in enumerate(majors, 1):
        prefix = "└──" if i == len(majors) else "├──"
        print(f"   {prefix} {major}")

total = sum(len(v) for v in data.values())
print(f"\n 合计：{len(data)} 个学院，{total} 个本科专业")

rows = []
for college, majors in data.items():
    for major in majors:
        rows.append({"学校": "嘉兴大学", "学院": college, "专业": major, "数量": 1})
df = pd.DataFrame(rows)

fig = px.sunburst(
    df,
    path=["学校", "学院", "专业"],   
    values="数量",
    title="嘉兴大学15个学院本科专业分布旭日图",
    color="学院",
    color_discrete_sequence=px.colors.qualitative.Alphabet,
    branchvalues="total",
)
fig.update_traces(textinfo="label+percent parent", insidetextorientation="radial")
fig.update_layout(
    width=1000, height=1000,
    margin=dict(t=80, l=20, r=20, b=20),
    title_x=0.5, title_font_size=22,
    font=dict(family="Microsoft YaHei, SimHei, Arial", size=13),
)

out_html = os.path.abspath("嘉兴大学本科专业旭日图.html")
fig.write_html(out_html, auto_open=True)
print(f"\n旭日图已生成：{out_html}")
print("   已在默认浏览器中打开。")